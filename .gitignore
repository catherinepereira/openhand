# Python (backend)
backend/venv/
backend/.venv/
backend/env/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment files — secrets (ELEVENLABS_API_KEY etc.)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Model artifacts — large files generated by openhand-model.
# The .onnx and .json are tiny (~250 KB) and required for the backend to
# work, so they ARE checked in. The MediaPipe .task file is ~8 MB and can
# be re-downloaded — but small enough that we keep it in-tree for ease.
# Per-letter intermediate caches should never be committed.
backend/models/artifacts/_per_letter/

# Frontend has its own .gitignore at frontend/.gitignore; this is just a
# safety net in case anything escapes upward.
node_modules/
dist/
dist-ssr/
*.local

# Editor / OS
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
logs/
