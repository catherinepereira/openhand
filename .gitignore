# Python (backend)
backend/venv/
backend/.venv/
backend/env/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment files — secrets (ELEVENLABS_API_KEY etc.)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Model artifacts — split policy:
#   - Alphabet MLP (`asl_classifier.onnx` ~250 KB, `model_meta.json`) IS
#     checked in — tiny, needed for the live-letter path.
#   - CTC transformer (`asl_ctc.onnx` ~116 MB, `asl_ctc_meta.json`) is
#     gitignored — too large for GitHub. Produced by openhand-model and
#     copied here manually.
#   - MediaPipe `.task` files are gitignored — fetched by
#     `backend/scripts/download_models.py` on setup.
backend/models/artifacts/asl_ctc.onnx
backend/models/artifacts/asl_ctc_meta.json
backend/models/artifacts/*.task
backend/models/artifacts/*.bak
backend/models/artifacts/_per_letter/

# Frontend has its own .gitignore at frontend/.gitignore; this is just a
# safety net in case anything escapes upward.
node_modules/
dist/
dist-ssr/
*.local

# Editor / OS
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
logs/
