# Copy to frontend/.env. Everything is optional.

# Show the text-to-speech button in the output bar. The button itself
# calls POST /api/tts, which only works if backend/.env has a valid
# ELEVENLABS_API_KEY. Leave false if you don't have a key.
VITE_TTS_ENABLED=false

# Override the backend origin. Default is http://localhost:8273.
# WebSocket URLs are derived by swapping http -> ws.
# VITE_API_BASE=http://localhost:8273
